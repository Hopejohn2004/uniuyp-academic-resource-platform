<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Forgot Password - Academic Resource Platform</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/nav') %>
  <div class="auth-container">
    <h2>Forgot Password</h2>
    <% if (error && error.length) { %><div class="flash error"><%= error[0] %></div><% } %>
    <p>Enter your account email and we will provide a password reset link.</p>
    <form method="POST" action="/forgot-password">
      <input type="hidden" name="csrfToken" value="<%= csrfToken %>" />
      <label>Email Address</label>
      <input type="email" name="email" required />
      <button type="submit">Request Reset</button>
    </form>
    <p><a class="link" href="/login">Back to Login</a></p>
  </div>
</body>
</html>
