<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title><%= course.code %> - Academic Resource Platform</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/nav') %>
  <div class="container">
    <div class="page-header">
      <h1><%= course.code %> — <%= course.title %></h1>
      <a class="btn btn-outline" href="/courses">Back to Courses</a>
    </div>

    <% if (error && error.length) { %><div class="flash error"><%= error[0] %></div><% } %>
    <% if (success && success.length) { %><div class="flash success"><%= success[0] %></div><% } %>

    <p class="hint">
      Owner: <strong><%= course.owner_department || '—' %></strong>
      <% if (course.level) { %> &middot; <%= course.level %><% } %>
      <% if (course.offered_departments) { %> &middot; Offered to: <%= course.offered_departments %><% } %>
    </p>

    <% if (!accessible) { %>
      <div class="empty-state">This course is only available to students in eligible departments. Your department is not currently listed for this course.</div>
    <% } else if (resources.length === 0) { %>
      <div class="empty-state">No resources uploaded for this course yet.</div>
    <% } %>

    <% resources.forEach(r => { %>
      <div class="resource-card">
        <div>
          <div class="r-title"><%= r.title %> <% if (r.category_name) { %><span class="badge"><%= r.category_name %></span><% } %></div>
          <div class="r-meta">
            <% if (r.level) { %><%= r.level %> &middot; <% } %><% if (r.semester) { %><%= r.semester %> &middot; <% } %><% if (r.download_count) { %><strong><%= r.download_count %></strong> download<%= r.download_count === 1 ? '' : 's' %> &middot; <% } %>
            Uploaded by <%= r.uploader || 'Admin' %> on <%= new Date(r.created_at).toDateString() %>
            &middot; <%= (r.file_size/1024).toFixed(0) %> KB
          </div>
          <% if (r.description) { %><div class="desc"><%= r.description %></div><% } %>
        </div>
        <div class="btn-row">
          <a class="btn" href="/resources/<%= r.id %>/download">Download</a>
          <% if (currentUser.accountType === 'administrator' || Number(r.uploaded_by) === Number(currentUser.id)) { %>
            <a class="btn btn-outline" href="/resources/<%= r.id %>/edit">Edit</a>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>
</body>
</html>
