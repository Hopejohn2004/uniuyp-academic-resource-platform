<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Verify Your Email - Academic Resource Platform</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/nav') %>
  <div class="auth-container" style="max-width:520px;">
    <h2>Check Your Email</h2>
    <% if (emailSent) { %>
      <p style="font-size:0.92rem; line-height:1.5;">
        We've sent a verification link to <strong><%= email %></strong>. Click the link in that
        email to activate your account, then log in.
      </p>
    <% } else { %>
      <div class="flash error" style="margin-bottom:16px;">
        We couldn't send the verification email right now (this can happen if the email service
        isn't configured on this server). You can still verify using the link below.
      </div>
    <% } %>

    <div style="background:#f4f6f4; border:1px dashed #c8d0c8; border-radius:8px; padding:14px; margin:18px 0;">
      <p style="font-size:0.8rem; color:#6b7280; margin:0 0 8px;">
        For testing / demo purposes, you can also verify directly using this link:
      </p>
      <a class="link" href="<%= verifyUrl %>" style="word-break:break-all; font-size:0.85rem;"><%= verifyUrl %></a>
    </div>

    <p style="font-size:0.85rem;">
      Didn't get the email? <a class="link" href="/resend-verification">Request a new link</a>.
    </p>
    <p style="font-size:0.85rem;"><a class="link" href="/login">Back to Login</a></p>
  </div>
</body>
</html>
