<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Verify Your Email - Academic Resource Platform</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/nav') %>
  <div class="auth-container auth-container-lg">
    <h2>Check Your Email</h2>
    <% if (emailSent) { %>
      <p class="lead">
        We've sent a verification link to <strong><%= email %></strong>. Click the link in that
        email to activate your account, then log in.
      </p>
    <% } else { %>
      <div class="flash error mb-16">
        We couldn't send the verification email right now (this can happen if the email service
        isn't configured on this server). You can still verify using the link below.
      </div>
    <% } %>

    <div class="demo-box">
      <p class="demo-label">
        For testing / demo purposes, you can also verify directly using this link:
      </p>
      <a class="link break-all" href="<%= verifyUrl %>"><%= verifyUrl %></a>
    </div>

    <p class="small">
      Didn't get the email? <a class="link" href="/resend-verification">Request a new link</a>.
    </p>
    <p class="small"><a class="link" href="/login">Back to Login</a></p>
  </div>
</body>
</html>
