<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>My Uploads - Academic Resource Platform</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/nav') %>
  <div class="container">
    <div class="page-header">
      <h1>My Uploads</h1>
      <a class="btn" href="/upload">+ Upload Resource</a>
    </div>

    <% if (error && error.length) { %><div class="flash error"><%= error[0] %></div><% } %>
    <% if (success && success.length) { %><div class="flash success"><%= success[0] %></div><% } %>

    <% if (resources.length === 0) { %>
      <div class="empty-state">You have not uploaded any resources yet.</div>
    <% } %>

    <% resources.forEach(r => { %>
      <div class="resource-card">
        <div>
          <div class="r-title"><%= r.title %> <% if (r.category_name) { %><span class="badge"><%= r.category_name %></span><% } %></div>
          <div class="r-meta">
            <% if (r.course_catalog_code || r.course_code) { %><%= r.course_catalog_code || r.course_code %><% if (r.course_title) { %> — <%= r.course_title %><% } %> &middot; <% } %><% if (r.level) { %><%= r.level %> &middot; <% } %><% if (r.semester) { %><%= r.semester %> &middot; <% } %><% if (r.download_count) { %><strong><%= r.download_count %></strong> download<%= r.download_count === 1 ? '' : 's' %> &middot; <% } %>
            Uploaded on <%= new Date(r.created_at).toDateString() %>
            &middot; <%= (r.file_size/1024).toFixed(0) %> KB
          </div>
        </div>
        <div style="display:flex; gap:8px;">
          <a class="btn" href="/resources/<%= r.id %>/download">View / Download</a>
          <a class="btn btn-outline" href="/resources/<%= r.id %>/edit">Edit</a>
          <form method="POST" action="/resources/<%= r.id %>/delete" onsubmit="return confirm('Delete this resource?');">
            <input type="hidden" name="csrfToken" value="<%= csrfToken %>" />
            <button type="submit" class="btn btn-danger">Delete</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
</body>
</html>
